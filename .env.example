# Leave OwnerRez values empty to run in demo mode (synthetic data only).
# Never commit real secrets — set these in Vercel > Project > Settings > Environment Variables.

# Personal access token (starts with pt_) + the OwnerRez login email it belongs to,
# OR an OAuth access token (starts with at_) + your OAuth client id.
OWNERREZ_ACCESS_TOKEN=
OWNERREZ_EMAIL=
OWNERREZ_CLIENT_ID=
OWNERREZ_API_BASE=https://api.ownerrez.com/v2

# Required for live data. Viewers must enter this team key in the page header;
# without it, everyone sees demo data even when a token is set.
REZAI_ACCESS_KEY=
